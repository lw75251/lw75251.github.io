---
import Base from '../layouts/Base.astro';
import Signal from '../components/Signal.astro';
import { SITE, RESUME_MAILTO, getWriting, getForecasts, formatDate } from '../site';
import { brier } from '../lib/forecasts';

const writing = (await getWriting()).slice(0, 5);
const resolved = getForecasts().filter((f) => f.outcome !== undefined);

const work = [
  {
    company: 'Replit',
    href: 'https://replit.com',
    title: 'Founding Member of Technical Staff, Data (Staff)',
    points: [
      { text: 'Growth, monetization and revenue metrics, and the data stack underneath them.' },
      { lead: 'Oracle', text: 'replaced Hex and Amplitude, saving seven figures a year.' },
    ],
  },
  {
    company: 'Indeed',
    href: 'https://www.indeed.com',
    title: 'BI Analyst → Senior Data Scientist, Finance',
    points: [
      { text: 'Revenue forecasting, lifetime-value models, and the revenue data mart.' },
      { lead: 'Text-to-SQL', text: 'prototyped in January 2023; it grew into a 10-person team.' },
    ],
  },
  {
    company: 'Rauxa',
    href: 'https://www.rauxa.com',
    title: 'Data Scientist',
    points: [{ text: 'Marketing analytics and experimentation.' }],
  },
];

---
<Base>
  <section class="hero" aria-labelledby="name">
    <h1 id="name" class="visually-hidden">Leon Wu</h1>
    <p class="kicker">Data science · data engineering · AI for data</p>
    <p class="lede">
      I built <em>Oracle</em>, Replit's AI data analyst. Over half the company asks it questions every week.
    </p>
    <figure class="hero-fig">
      <Signal seed="hero" width={640} height={64} points={64} strokeWidth={1.5} dot={4.5} class="hero-signal" />
      <figcaption>A random walk with one real shift. My job is finding the dot.</figcaption>
    </figure>
    <p class="bio">
      I'm on Replit's founding data team, working on growth, monetization and revenue. I also own the data
      underneath: event instrumentation through 1,000+ dbt models on a petabyte-scale warehouse.
    </p>
  </section>

  <section aria-labelledby="work">
    <h2 class="kicker" id="work">Work</h2>
    <ul class="entries jobs">
      {work.map((w) => (
        <li>
          <div class="row">
            <span class="title"><a href={w.href} class="co">{w.company}</a> <span class="role">{w.title}</span></span>
            {w.points.map((pt) => (
              <span class="desc">{pt.lead && <strong>{pt.lead} </strong>}{pt.text}</span>
            ))}
          </div>
        </li>
      ))}
    </ul>
  </section>

  {writing.length > 0 && (
    <section aria-labelledby="writing">
      <h2 class="kicker" id="writing">Writing</h2>
      <ul class="entries">
        {writing.map((p) => (
          <li>
            <a href={`/writing/${p.id}/`}>
              <span class="sig">
                <Signal seed={p.id} />
                <span class="title">{p.data.title}</span>
              </span>
              <span class="meta">{formatDate(p.data.date)}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {resolved.length >= 5 && (
    <section aria-labelledby="calibration">
      <h2 class="kicker" id="calibration">Calibration</h2>
      <p>
        Brier score <strong>{brier(resolved).toFixed(2)}</strong> across {resolved.length} resolved public forecasts.
        <a href="/forecasts">See every forecast →</a>
      </p>
    </section>
  )}


  <section aria-labelledby="hello">
    <h2 class="kicker" id="hello">Get in touch</h2>
    <p>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>{' · '}<a href={SITE.linkedin}>LinkedIn</a>{' · '}<a href={RESUME_MAILTO}>Resume on request</a>
    </p>
  </section>
</Base>

<style>
  .hero .kicker { margin-bottom: 1.5rem; }
  .hero .lede { max-width: 36rem; }
  .hero-fig { margin: 2.25rem 0 2rem; }
  .hero :global(.hero-signal) { width: 100%; height: auto; color: var(--line); }
  .hero-fig figcaption { font-family: var(--mono); font-size: 0.72rem; color: var(--muted); margin-top: 0.6rem; }
  .jobs .desc strong { color: var(--ink); font-weight: 600; }
  .jobs .desc + .desc { margin-top: 0.5rem; }
  .bio { margin: 0; max-width: 35rem; color: var(--muted); }
  .jobs .co { display: inline; padding: 0; text-decoration: none; }
  .jobs .role { font-family: var(--sans); font-size: 0.92rem; color: var(--muted); margin-left: 0.4rem; }
  @media (max-width: 560px) { .jobs .role { display: block; margin: 0.15rem 0 0; } }
</style>
