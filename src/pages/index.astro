---
import Base from '../layouts/Base.astro';
import Signal from '../components/Signal.astro';
import { SITE, RESUME_MAILTO, getWriting, getForecasts, formatDate } from '../site';
import { brier } from '../lib/forecasts';

const writing = (await getWriting()).slice(0, 5);
const resolved = getForecasts().filter((f) => f.outcome !== undefined);

const work = [
  {
    company: 'Replit',
    href: 'https://replit.com',
    title: 'Founding Data Scientist',
    what: 'One of the first two people on the data team. I built and run the internal analytics agent over half the company uses every week, and I own billing and product data end to end.',
  },
  {
    company: 'Indeed',
    href: 'https://www.indeed.com',
    title: 'Senior Data Scientist',
    what: 'Prototyped Indeed’s Text-to-SQL assistant in early 2023. It grew into a 10-person team and a tool thousands of people used weekly. Also built the self-serve forecasting platform more than 20 teams ran their models on.',
  },
  {
    company: 'Rauxa',
    href: 'https://www.rauxa.com',
    title: 'Data Scientist',
    what: 'Marketing analytics and experimentation for agency clients.',
  },
];

const built = [
  { name: 'Quairy', href: 'https://github.com/lw75251/datasetai', what: 'An early Text-to-SQL agent from 2023 (ReAct plus retrieval) that also answers questions over messy, multi-table spreadsheets.' },
  { name: 'AI Solution Explorer', href: 'https://github.com/lw75251/ai_solutions_generator', what: 'Generates candidate approaches to a hard problem with Claude, then scores each one for feasibility and risk.' },
];
---
<Base>
  <section class="hero" aria-labelledby="name">
    <h1 id="name" class="name">Leon Wu</h1>
    <p class="kicker">Agents · evals · data infrastructure</p>
    <p class="lede">
      I build agents that answer data questions <em>correctly</em>, and the semantic layers and evals that keep them honest.
    </p>
    <Signal seed="hero" width={640} height={64} points={64} strokeWidth={1.5} dot={4.5} class="hero-signal" />
    <p class="bio">
      I'm the founding data scientist at Replit. I own the company's revenue metrics, and I've kept them
      consistent through two fundraises. Before that, at Indeed, I built one of the first
      LLM tools for asking data questions in plain English. I studied probability and statistics, so I don't trust
      a number until I know where it came from.
    </p>
  </section>

  <section aria-labelledby="work">
    <h2 class="kicker" id="work">Work</h2>
    <ul class="entries jobs">
      {work.map((w) => (
        <li>
          <div class="row">
            <span class="title"><a href={w.href} class="co">{w.company}</a> <span class="role">{w.title}</span></span>
            <span class="desc">{w.what}</span>
          </div>
        </li>
      ))}
    </ul>
  </section>

  {writing.length > 0 && (
    <section aria-labelledby="writing">
      <h2 class="kicker" id="writing">Writing</h2>
      <ul class="entries">
        {writing.map((p) => (
          <li>
            <a href={`/writing/${p.id}/`}>
              <span class="sig">
                <Signal seed={p.id} />
                <span class="title">{p.data.title}</span>
              </span>
              <span class="meta">{formatDate(p.data.date)}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {resolved.length >= 5 && (
    <section aria-labelledby="calibration">
      <h2 class="kicker" id="calibration">Calibration</h2>
      <p>
        Brier score <strong>{brier(resolved).toFixed(2)}</strong> across {resolved.length} resolved public forecasts.
        <a href="/forecasts">See every forecast →</a>
      </p>
    </section>
  )}

  <section aria-labelledby="built">
    <h2 class="kicker" id="built">Side projects</h2>
    <ul class="entries">
      {built.map((b) => (
        <li>
          <a href={b.href}>
            <span class="title">{b.name}</span>
            <span class="meta">GitHub ↗</span>
            <span class="desc">{b.what}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="hello">
    <h2 class="kicker" id="hello">Get in touch</h2>
    <p>
      Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a> or find me on <a href={SITE.linkedin}>LinkedIn</a>.
      My resume is <a href={RESUME_MAILTO}>one email away</a>.
    </p>
  </section>
</Base>

<style>
  .name { font-size: 1rem; font-family: var(--sans); font-weight: 600; letter-spacing: 0; margin: 0 0 0.35rem; }
  .hero .kicker { margin-bottom: 1.5rem; }
  .hero .lede { max-width: 35rem; }
  .hero :global(.hero-signal) { width: 100%; height: auto; margin: 2.25rem 0 2rem; color: var(--line); }
  .bio { margin: 0; max-width: 35rem; color: var(--muted); }
  .jobs .co { display: inline; padding: 0; text-decoration: none; }
  .jobs .role { font-family: var(--sans); font-size: 0.92rem; color: var(--muted); margin-left: 0.4rem; }
  @media (max-width: 560px) { .jobs .role { display: block; margin: 0.15rem 0 0; } }
</style>
