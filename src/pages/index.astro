---
import Base from '../layouts/Base.astro';
import Signal from '../components/Signal.astro';
import { SITE, RESUME_MAILTO, getWriting, getForecasts, formatDate } from '../site';
import { brier } from '../lib/forecasts';

const writing = (await getWriting()).slice(0, 5);
const resolved = getForecasts().filter((f) => f.outcome !== undefined);

const work = [
  {
    company: 'Replit',
    href: 'https://replit.com',
    title: 'Founding Member of Technical Staff, Data (Staff)',
    points: [
      { text: 'Growth and monetization: pricing tests, upgrade prompts, lead scoring. I own the revenue metrics and the data stack beneath them, from event instrumentation through dbt to reporting.' },
      { lead: 'Oracle.', text: 'Led our internal analytics agent, from the agent harness to the semantic layer underneath. Over half the company uses it every week, and it replaced Hex and Amplitude, saving seven figures a year.' },
    ],
  },
  {
    company: 'Indeed',
    href: 'https://www.indeed.com',
    title: 'BI Analyst → Senior Data Scientist, Finance',
    points: [
      { text: 'Revenue forecasting for leadership, and customer lifetime-value models that guided marketing spend.' },
      { lead: 'Text-to-SQL.', text: 'Prototyped Indeed’s Text-to-SQL assistant in January 2023. It grew into a 10-person team and a tool thousands of people used weekly.' },
    ],
  },
  {
    company: 'Rauxa',
    href: 'https://www.rauxa.com',
    title: 'Data Scientist',
    points: [{ text: 'Marketing analytics, A/B testing and attribution for agency clients.' }],
  },
];

const built = [
  { name: 'Quairy', href: 'https://github.com/lw75251/datasetai', what: 'An early Text-to-SQL agent from 2023 (ReAct plus retrieval) that also answers questions over messy, multi-table spreadsheets.' },
  { name: 'AI Solution Explorer', href: 'https://github.com/lw75251/ai_solutions_generator', what: 'Generates candidate approaches to a hard problem with Claude, then scores each one for feasibility and risk.' },
];
---
<Base>
  <section class="hero" aria-labelledby="name">
    <h1 id="name" class="visually-hidden">Leon Wu</h1>
    <p class="kicker">Growth · monetization · AI for data</p>
    <p class="lede">
      I work on the questions companies <em>make money on</em>, then build AI tools so people can answer the next one without me.
    </p>
    <figure class="hero-fig">
      <Signal seed="hero" width={640} height={64} points={64} strokeWidth={1.5} dot={4.5} class="hero-signal" />
      <figcaption>A random walk with one real shift. My job is finding the dot.</figcaption>
    </figure>
    <p class="bio">
      I'm on Replit's founding data team. Before that, I did finance data science at Indeed. I studied probability and
      statistics, so I don't trust a number until I know where it came from.
    </p>
  </section>

  <section aria-labelledby="work">
    <h2 class="kicker" id="work">Work</h2>
    <ul class="entries jobs">
      {work.map((w) => (
        <li>
          <div class="row">
            <span class="title"><a href={w.href} class="co">{w.company}</a> <span class="role">{w.title}</span></span>
            {w.points.map((pt) => (
              <span class="desc">{pt.lead && <strong>{pt.lead} </strong>}{pt.text}</span>
            ))}
          </div>
        </li>
      ))}
    </ul>
  </section>

  {writing.length > 0 && (
    <section aria-labelledby="writing">
      <h2 class="kicker" id="writing">Writing</h2>
      <ul class="entries">
        {writing.map((p) => (
          <li>
            <a href={`/writing/${p.id}/`}>
              <span class="sig">
                <Signal seed={p.id} />
                <span class="title">{p.data.title}</span>
              </span>
              <span class="meta">{formatDate(p.data.date)}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {resolved.length >= 5 && (
    <section aria-labelledby="calibration">
      <h2 class="kicker" id="calibration">Calibration</h2>
      <p>
        Brier score <strong>{brier(resolved).toFixed(2)}</strong> across {resolved.length} resolved public forecasts.
        <a href="/forecasts">See every forecast →</a>
      </p>
    </section>
  )}

  <section aria-labelledby="built">
    <h2 class="kicker" id="built">Side projects</h2>
    <ul class="entries">
      {built.map((b) => (
        <li>
          <a href={b.href}>
            <span class="title">{b.name}</span>
            <span class="meta">GitHub ↗</span>
            <span class="desc">{b.what}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="hello">
    <h2 class="kicker" id="hello">Get in touch</h2>
    <p>
      Happy to talk pricing, experimentation, evals or agent harnesses. Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a>{' '}
      or find me on <a href={SITE.linkedin}>LinkedIn</a>. My resume is <a href={RESUME_MAILTO}>one email away</a>.
    </p>
  </section>
</Base>

<style>
  .hero .kicker { margin-bottom: 1.5rem; }
  .hero .lede { max-width: 36rem; }
  .hero-fig { margin: 2.25rem 0 2rem; }
  .hero :global(.hero-signal) { width: 100%; height: auto; color: var(--line); }
  .hero-fig figcaption { font-family: var(--mono); font-size: 0.72rem; color: var(--muted); margin-top: 0.6rem; }
  .jobs .desc strong { color: var(--ink); font-weight: 600; }
  .jobs .desc + .desc { margin-top: 0.5rem; }
  .bio { margin: 0; max-width: 35rem; color: var(--muted); }
  .jobs .co { display: inline; padding: 0; text-decoration: none; }
  .jobs .role { font-family: var(--sans); font-size: 0.92rem; color: var(--muted); margin-left: 0.4rem; }
  @media (max-width: 560px) { .jobs .role { display: block; margin: 0.15rem 0 0; } }
</style>
