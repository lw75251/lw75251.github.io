---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Signal from '../../components/Signal.astro';
import { getWriting, formatDate, readingTime } from '../../site';

export async function getStaticPaths() {
  const posts = await getWriting();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description}>
  <article>
    <header class="post-head">
      <Signal seed={post.id} width={140} height={32} points={36} />
      <h1>{post.data.title}</h1>
      <p class="meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, 'long')}</time>{' · '}{readingTime(post.body)} min read
        {post.data.draft && <span class="draft">Draft (only visible in dev)</span>}
      </p>
    </header>
    <div class="prose">
      <Content />
    </div>
    <p class="back"><a href="/writing">← All writing</a></p>
  </article>
</Base>

<style>
  .post-head { margin-bottom: 2.75rem; }
  .post-head h1 { margin-top: 1.5rem; }
  .meta { font-family: var(--mono); font-size: 0.78rem; color: var(--muted); margin: 1rem 0 0; }
  .draft { margin-left: 0.75rem; color: var(--accent); }
  .back { margin-top: 4rem; font-size: 0.92rem; }
</style>
