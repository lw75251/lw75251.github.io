---
import Base from '../../layouts/Base.astro';
import Signal from '../../components/Signal.astro';
import { getWriting, formatDate } from '../../site';

const writing = await getWriting();
---
<Base title="Writing" description="Essays and notes by Leon Wu on data, statistics and agents.">
  <h1>Writing</h1>
  <p class="muted sub">Essays on data, statistics and building with agents, plus shorter notes. You can also follow along by <a href="/rss.xml">RSS</a>.</p>
  {writing.length > 0 ? (
    <ul class="entries">
      {writing.map((p) => (
        <li>
          <a href={`/writing/${p.id}/`}>
            <span class="sig">
              <Signal seed={p.id} />
              <span class="title">{p.data.title}{p.data.draft && <span class="meta"> · draft</span>}</span>
            </span>
            <span class="meta">{formatDate(p.data.date)}</span>
            <span class="desc">{p.data.description}</span>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="muted">Nothing published yet. The first essays are being written.</p>
  )}
</Base>

<style>
  .sub { margin: 1rem 0 2.5rem; }
</style>
